{
  "name": "AgentFuel402 - B2B Intent Leads Enrichment to CRM",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 4
            }
          ]
        }
      },
      "name": "Schedule Trigger (Every 4 Hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://agentfuel402.ak10082247.workers.dev/v1/preview/b2b-intent-leads",
        "options": {}
      },
      "name": "Fetch AgentFuel B2B Intent Leads",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [480, 300]
    },
    {
      "parameters": {
        "fieldToSplitOut": "leads",
        "options": {}
      },
      "name": "Item Lists - Split Out Leads",
      "type": "n8n-nodes-base.itemLists",
      "typeVersion": 3,
      "position": [700, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.intent_score }}",
              "operation": "largerEqual",
              "value2": 60
            }
          ]
        }
      },
      "name": "Filter High Intent Leads (Score >= 60)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [920, 300]
    }
  ],
  "connections": {
    "Schedule Trigger (Every 4 Hours)": {
      "main": [
        [
          {
            "node": "Fetch AgentFuel B2B Intent Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch AgentFuel B2B Intent Leads": {
      "main": [
        [
          {
            "node": "Item Lists - Split Out Leads",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Item Lists - Split Out Leads": {
      "main": [
        [
          {
            "node": "Filter High Intent Leads (Score >= 60)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
