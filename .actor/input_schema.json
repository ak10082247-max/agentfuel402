{
  "title": "AgentFuel402 Input Schema",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "mode": {
      "title": "Execution Mode",
      "type": "string",
      "description": "Select data feed engine to execute",
      "editor": "select",
      "default": "b2b-intent-leads",
      "enum": ["b2b-intent-leads", "llm-clean-markdown", "ecom-price-stock", "reverse-engineer-anything"],
      "enumTitles": ["B2B Intent Leads ($0.010 USD / lead)", "LLM Clean Markdown ($0.003 USD / URL)", "E-Commerce Price & Stock ($0.003 USD / URL)", "Reverse Engineer Anything (REA) ($0.015 USD / URL)"]
    },
    "maxLeads": {
      "title": "Max Leads (B2B Batch)",
      "type": "integer",
      "description": "Maximum distinct B2B company signals to return (default 50, max 500; billed 1 lead-signal-fetch event per lead delivered)",
      "default": 50,
      "minimum": 1,
      "maximum": 500
    },
    "urls": {
      "title": "Target URLs (Batch up to 100)",
      "type": "array",
      "description": "Optional array of up to 100 target URLs for bulk Markdown extraction, e-commerce price/stock monitoring, or reverse-engineering (billed 1 event per succeeded URL)",
      "editor": "stringList",
      "maxItems": 100,
      "items": {
        "type": "string"
      }
    },
    "url": {
      "title": "Target URL (Single Fallback)",
      "type": "string",
      "description": "Single webpage or product URL when urls array is empty",
      "editor": "textfield",
      "default": "https://news.ycombinator.com"
    },
    "limit": {
      "title": "Legacy Leads Limit Alias",
      "type": "integer",
      "description": "Optional fallback alias for maxLeads (1-500)",
      "default": 50,
      "minimum": 1,
      "maximum": 500
    },
    "category": {
      "title": "B2B Category",
      "type": "string",
      "description": "Filter leads by industry / category",
      "default": "all",
      "editor": "select",
      "enum": ["all", "ai", "devtools", "saas", "ecommerce"]
    }
  }
}
